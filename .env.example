# Local SQLite is used when DATABASE_URL is empty.
# On Render, set this to the existing managed PostgreSQL connection string for persistence.
DATABASE_URL=
DB_SCHEMA=harness

# Operator-only permission for manually triggering replay evaluations.
HUB_API_KEY=

# Project-specific ingestion tokens. Use three different random values.
# Example shape (replace all values; never commit real secrets):
# HARNESS_INGEST_TOKENS_JSON={"evidenceflow":"<EVIDENCEFLOW_TOKEN>","quotesense":"<QUOTESENSE_TOKEN>","flowpilot":"<FLOWPILOT_TOKEN>"}
HARNESS_INGEST_TOKENS_JSON=

# Optional dedicated credentials take precedence over the JSON map for that project.
HARNESS_EVIDENCEFLOW_INGEST_TOKEN=
HARNESS_QUOTESENSE_INGEST_TOKEN=
HARNESS_FLOWPILOT_INGEST_TOKEN=
